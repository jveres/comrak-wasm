{
	"compilerOptions": {
		"strict": true,
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"skipLibCheck": false,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUncheckedIndexedAccess": true,
		"noUncheckedSideEffectImports": true,
		"types": ["node"],
		"paths": {
			"comrak-wasm": ["./types.d.ts"]
		}
	},
	"include": [
		"types.d.ts",
		"comrak.test.ts",
		"vitest.config.ts",
		"examples/**/*.ts",
		"examples/**/*.js",
		"examples/**/*.mjs"
	],
	"exclude": ["examples/playground/dist"]
}
